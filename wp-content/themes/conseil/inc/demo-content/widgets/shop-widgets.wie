{"sidebar-shop":{"block-40":{"content":"<!-- wp:spacer {\"height\":\"15px\"} -->\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n<!-- \/wp:spacer -->"},"block-13":{"content":"<!-- wp:woocommerce\/filter-wrapper {\"filterType\":\"price-filter\",\"heading\":\"Filter by price\"} -->\n<div class=\"wp-block-woocommerce-filter-wrapper\"><!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"20px\"}}} -->\n<h3 class=\"wp-block-heading\" style=\"font-size:20px\">Filter by price<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:woocommerce\/price-filter {\"heading\":\"\",\"lock\":{\"remove\":true}} -->\n<div class=\"wp-block-woocommerce-price-filter is-loading\"><span aria-hidden=\"true\" class=\"wc-block-product-categories__placeholder\"><\/span><\/div>\n<!-- \/wp:woocommerce\/price-filter --><\/div>\n<!-- \/wp:woocommerce\/filter-wrapper -->"},"block-9":{"content":"<!-- wp:spacer {\"height\":\"10px\"} -->\n<div style=\"height:10px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n<!-- \/wp:spacer -->"},"block-7":{"content":"<!-- wp:heading {\"level\":5,\"fontSize\":\"medium\"} -->\n<h5 class=\"wp-block-heading has-medium-font-size\"><strong>Search<\/strong><\/h5>\n<!-- \/wp:heading -->"},"block-8":{"content":"<!-- wp:pixfort-core\/pix-small-search \/-->"},"block-41":{"content":"<!-- wp:spacer {\"height\":\"10px\"} -->\n<div style=\"height:10px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n<!-- \/wp:spacer -->"},"block-10":{"content":"<!-- wp:heading {\"level\":5,\"fontSize\":\"medium\"} -->\n<h5 class=\"wp-block-heading has-medium-font-size\"><strong>Promo Box<\/strong><\/h5>\n<!-- \/wp:heading -->"},"block-32":{"content":"<!-- wp:pixfort-core\/pix-promo-box {\"bg_img_url\":\"https:\/\/theme.pixfort.com\/product\/wp-content\/uploads\/sites\/8\/2025\/01\/coming-soon-image-2.webp\",\"badge\":\"Promo Box\",\"heading\":\"Experience Seamless Style and Speed\",\"link_text\":\"Explore the Theme\"} \/-->"},"block-35":{"